{"rule_id":"R-DOM-COMP-001","nome":"Papéis válidos da composição","tipo":"dominio","versao":"1.0","status":"ativa","prioridade":100,"escopo":{},"antecedentes":[{"campo":"categoria","operador":"=","valor":"composicao"}],"conclusoes":[{"campo":"papeis_validos","valor":["parte_1","parte_2","todo"]}],"fontes":["teoria_campos_conceituais","regras_gerard"],"evidencias":[],"metricas":{},"explicacao":"Problemas de composição relacionam duas partes e um todo.","limites":[]}
{"rule_id":"R-DOM-COMP-002","nome":"Invariante da composição","tipo":"dominio","versao":"1.0","status":"ativa","prioridade":100,"escopo":{},"antecedentes":[{"campo":"categoria","operador":"=","valor":"composicao"}],"conclusoes":[{"campo":"relacao_aditiva","valor":"parte_1 + parte_2 = todo"}],"fontes":["teoria_campos_conceituais","regras_gerard"],"evidencias":[],"metricas":{},"explicacao":"O todo é formado pela combinação das duas partes.","limites":[]}
{"rule_id":"R-DOM-TRANS-001","nome":"Papéis válidos da transformação","tipo":"dominio","versao":"1.0","status":"ativa","prioridade":100,"escopo":{},"antecedentes":[{"campo":"categoria","operador":"=","valor":"transformacao"}],"conclusoes":[{"campo":"papeis_validos","valor":["estado_inicial","transformacao","estado_final"]}],"fontes":["teoria_campos_conceituais","regras_gerard"],"evidencias":[],"metricas":{},"explicacao":"Problemas de transformação relacionam estado inicial, transformação e estado final.","limites":[]}
{"rule_id":"R-DOM-TRANS-002","nome":"Invariante da transformação","tipo":"dominio","versao":"1.0","status":"ativa","prioridade":100,"escopo":{},"antecedentes":[{"campo":"categoria","operador":"=","valor":"transformacao"}],"conclusoes":[{"campo":"relacao_aditiva","valor":"estado_inicial + transformacao = estado_final"}],"fontes":["teoria_campos_conceituais","regras_gerard"],"evidencias":[],"metricas":{},"explicacao":"A transformação, com seu sinal semântico, modifica o estado inicial.","limites":[]}
{"rule_id":"R-DOM-COMP-003","nome":"Papéis válidos da comparação","tipo":"dominio","versao":"1.0","status":"ativa","prioridade":100,"escopo":{},"antecedentes":[{"campo":"categoria","operador":"=","valor":"comparacao"}],"conclusoes":[{"campo":"papeis_validos","valor":["referido","referendo","valor_relativo"]}],"fontes":["teoria_campos_conceituais","regras_gerard"],"evidencias":[],"metricas":{},"explicacao":"Problemas de comparação relacionam referido, referendo e valor relativo.","limites":[]}
{"rule_id":"R-DOM-COMP-004","nome":"Invariante da comparação","tipo":"dominio","versao":"1.0","status":"ativa","prioridade":100,"escopo":{},"antecedentes":[{"campo":"categoria","operador":"=","valor":"comparacao"}],"conclusoes":[{"campo":"relacao_aditiva","valor":"referendo + valor_relativo = referido"}],"fontes":["teoria_campos_conceituais","regras_gerard"],"evidencias":[],"metricas":{},"explicacao":"O valor relativo expressa a diferença orientada entre as duas medidas.","limites":[]}
