{"rule_id":"R-DOM-SINAL-002","nome":"Perda implica transformação negativa","tipo":"dominio","versao":"1.0","status":"ativa","prioridade":100,"escopo":{},"antecedentes":[{"campo":"categoria","operador":"=","valor":"transformacao"},{"campo":"evento_semantico","operador":"=","valor":"perda"}],"conclusoes":[{"campo":"sinal_esperado","valor":"negativo"}],"fontes":["regras_gerard"],"evidencias":[],"metricas":{},"explicacao":"Retirada, gasto ou perda produzem transformação negativa.","limites":[]}
