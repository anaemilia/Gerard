{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gerard.local/schema/log-multiagente-canonico-2.0.0.json",
  "title": "Log canônico de auditoria multiagente do Gérard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tipo_registro",
    "identificacao",
    "classificacao_evento",
    "acao_usuario",
    "agents",
    "interaction_result"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "tipo_registro": {
      "enum": [
        "evento",
        "episode_summary"
      ]
    },
    "identificacao": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "episode_id",
        "session_id",
        "gesture_id",
        "action_id",
        "evaluation_id",
        "step_user",
        "step_internal",
        "timestamp",
        "user_id",
        "problem_id",
        "category",
        "system_version",
        "rules_base_version",
        "execution_sequence"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "gesture_id": {
          "type": "string",
          "minLength": 1
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "evaluation_id": {
          "type": "string",
          "minLength": 1
        },
        "step_user": {
          "type": "integer",
          "minimum": 1
        },
        "step_internal": {
          "type": "integer",
          "minimum": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "user_id": {
          "type": "string",
          "minLength": 1
        },
        "problem_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "composicao",
            "transformacao",
            "comparacao"
          ]
        },
        "unknown_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "system_version": {
          "type": "string",
          "minLength": 1
        },
        "rules_base_version": {
          "type": "string",
          "minLength": 1
        },
        "execution_sequence": {
          "type": "array",
          "const": [
            "MONITOR",
            "ZDP",
            "MODELADOR"
          ]
        }
      }
    },
    "classificacao_evento": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "canonical",
        "reactive_evaluation",
        "counts_for_user_profile",
        "counts_for_error_sequence",
        "counts_for_case_base",
        "counts_for_rule_learning",
        "idempotency_key"
      ],
      "properties": {
        "origin": {
          "enum": [
            "soltura_usuario",
            "selecao_categoria",
            "selecao_sinal",
            "quantificacao",
            "solicitacao_ajuda",
            "sincronizacao_representacoes",
            "reavaliacao_consistencia",
            "outro"
          ]
        },
        "canonical": {
          "type": "boolean"
        },
        "reactive_evaluation": {
          "type": "boolean"
        },
        "counts_for_user_profile": {
          "type": "boolean"
        },
        "counts_for_error_sequence": {
          "type": "boolean"
        },
        "counts_for_case_base": {
          "type": "boolean"
        },
        "counts_for_rule_learning": {
          "type": "boolean"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "acao_usuario": {
      "type": "object"
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "MONITOR",
        "ZDP",
        "MODELADOR"
      ],
      "properties": {
        "MONITOR": {
          "$ref": "#/$defs/agente"
        },
        "ZDP": {
          "$ref": "#/$defs/agente"
        },
        "MODELADOR": {
          "$ref": "#/$defs/agente"
        }
      }
    },
    "interaction_result": {
      "type": "object",
      "required": [
        "comparison_status",
        "expected",
        "observed",
        "divergence"
      ],
      "properties": {
        "comparison_status": {
          "enum": [
            "evaluated",
            "not_evaluable"
          ]
        },
        "expected": {
          "type": [
            "object",
            "null"
          ]
        },
        "observed": {
          "type": "object"
        },
        "divergence": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "divergence_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "divergence_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "responsible_agent": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "regra": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "rule_id",
        "source",
        "version",
        "antecedents_satisfied",
        "conclusion",
        "priority",
        "used_in_final_decision"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "antecedents_satisfied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conclusion": {
          "type": [
            "string",
            "object"
          ]
        },
        "priority": {
          "type": "integer"
        },
        "used_in_final_decision": {
          "type": "boolean"
        },
        "discard_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "agente": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "input",
        "decision",
        "rules_fired",
        "output",
        "processing_time_ms",
        "error"
      ],
      "properties": {
        "input": {
          "type": "object"
        },
        "state_before": {
          "type": "object"
        },
        "profile_before": {
          "type": "object"
        },
        "decision": {
          "type": "object"
        },
        "rules_fired": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/regra"
          }
        },
        "output": {
          "type": "object"
        },
        "state_after": {
          "type": "object"
        },
        "profile_after": {
          "type": "object"
        },
        "state_change": {
          "type": "object"
        },
        "update_applied": {
          "type": "object"
        },
        "processing_time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": [
            "object",
            "string",
            "null"
          ]
        }
      }
    }
  }
}